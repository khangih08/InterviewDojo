# ── Required API keys ─────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# Get a free key at https://aistudio.google.com/app/apikey
Gemini_API_KEY=your-gemini-api-key

# Google OAuth client ID (https://console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id

# ── Auth secrets (change before deploying to production) ──────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# ── Email / SMTP (optional — only needed for forgot-password flow) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SECURE=false
SMTP_FROM="Interview Dojo <no-reply@yourdomain.com>"

# ── Frontend URL override (only needed for prod profile) ──────────────────────
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
